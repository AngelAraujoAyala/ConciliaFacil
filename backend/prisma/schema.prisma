generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ConciliationStatus {
  DRAFT
  COMPLETED
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  isSubscribed          Boolean        @default(false)
  freeConciliationsLeft Int            @default(1)
  conciliations         Conciliation[]

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@map("users")
}

model Conciliation {
  id                     String             @id @default(uuid())
  title                  String
  status                 ConciliationStatus @default(DRAFT)

  totalInvoices          Int                @default(0)
  totalBankMovements     Int                @default(0)
  matchedCount           Int                @default(0)
  successRate            Int
  schemaVersion          Int                @default(2)

  // JSONB v2: matches = ConciliationGroup[] (relaciones M:N por IDs)
  matches                Json
  movements              Json               @default("[]")
  invoices               Json               @default("[]")
  remainingInvoices      Json
  remainingBankMovements Json

  userId                 String
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId])
  @@index([schemaVersion])
  @@map("conciliations")
}

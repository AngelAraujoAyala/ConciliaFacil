generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ConciliationStatus {
  DRAFT
  COMPLETED
}

enum UserPlan {
  FREE
  BASIC
  PRO
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  plan                  UserPlan       @default(FREE)
  isSubscribed          Boolean        @default(false)
  freeConciliationsLeft Int            @default(1)
  monthlyConciliations  Int            @default(0)
  nextResetDate         DateTime       @default(now())
  conciliations         Conciliation[]
  empresas              Empresa[]

  // ==== CAMPOS AGREGADOS PARA STRIPE ====
  stripeCustomerId       String?   @unique // ID del cliente asignado por Stripe
  stripeSubscriptionId   String?   @unique // ID de la suscripción activa
  stripePriceId          String?   // Identifica qué plan compró (price_...)
  subscriptionStatus     String?   // Estado según Stripe (active, trialing, past_due, canceled)
  currentPeriodEnd       DateTime? // Fin del ciclo de facturación actual de Stripe

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@map("users")
}

model Empresa {
  id            String         @id @default(uuid())
  rfc           String
  razonSocial   String
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conciliations Conciliation[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([rfc, userId])
  @@index([userId])
  @@map("empresas")
}

model Conciliation {
  id                     String             @id @default(uuid())
  title                  String
  status                 ConciliationStatus @default(DRAFT)
  rfcEmpresa             String?

  totalInvoices          Int                @default(0)
  totalBankMovements     Int                @default(0)
  matchedCount           Int                @default(0)
  successRate            Int
  schemaVersion          Int                @default(2)

  // JSONB v2: matches = ConciliationGroup[] (relaciones M:N por IDs)
  matches                Json
  movements              Json               @default("[]")
  invoices               Json               @default("[]")
  remainingInvoices      Json
  remainingBankMovements Json

  userId                 String
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  empresaId              String?
  empresa                Empresa?           @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId])
  @@index([empresaId])
  @@index([schemaVersion])
  @@map("conciliations")
}
